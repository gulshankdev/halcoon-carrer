# ==============================================================================
# HALCON CAREER - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development or set these variables in production.
# NEVER commit the actual .env file with secrets into version control.

# Core Django Settings
DEBUG=True
SECRET_KEY=django-insecure-change-this-to-a-strong-random-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
# Leave DATABASE_URL empty or unset for local SQLite, or provide PostgreSQL URI:
# DATABASE_URL=postgres://user:password@hostname:5432/halcon_career_db
DATABASE_URL=

# Security Settings (Set to True in production with SSL / HTTPS)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# Email Settings
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For production SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your_smtp_key
# DEFAULT_FROM_EMAIL=HALCON CAREER <noreply@halconcareer.com>

# Company Information Settings
COMPANY_NAME=HALCON CAREER
COMPANY_TAGLINE=Connecting Talent. Creating Opportunities.
COMPANY_ADDRESS=SCO 12–13, 2nd Floor, Phase 11, Mohali, Punjab – 160065
COMPANY_PHONE_PRIMARY=+91 9216033444
COMPANY_PHONE_SECONDARY=+91 8699000984
COMPANY_EMAIL=contact@halconcareer.com
COMPANY_HOURS=Mon - Fri: 9:30 AM – 6:30 PM | Sat: 10:00 AM – 2:00 PM
